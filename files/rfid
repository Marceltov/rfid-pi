def render_page(lang):
    t = COPY[lang]
    langs = " ".join(
        '<a href="/?lang=%s" lang="%s" hreflang="%s"%s>%s</a>'
        % (code, code, code, ' aria-current="true"' if code == lang else "", html.escape(c["lang_name"]))
        for code, c in COPY.items())
    page = PAGE.replace("__LANG__", lang).replace("__LANGS__", langs)
    page = page.replace("__COPY__", json.dumps(t, ensure_ascii=False).replace("</", "<\\/"))
    for name, text in t.items():
        if isinstance(text, str):
            page = page.replace("__%s__" % name.upper(), html.escape(text))
    return page


def make_server(reader_factory, port=80, timeout=20, host=""):
    import http.server
    lock = threading.Lock()

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "rfid"

        def send(self, status, body, content_type, extra=()):
            data = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            for header in extra:
                self.send_header(*header)
            self.end_headers()
            self.wfile.write(data)

        def send_json(self, status, payload):
            self.send(status, json.dumps(payload, ensure_ascii=False), "application/json; charset=utf-8")

        def with_reader(self, action):
            if not lock.acquire(blocking=False):
                return self.send_json(409, {"error": "the reader is busy"})
            try:
                reader = reader_factory()
                try:
                    result = action(reader)
                finally:
                    reader.close()
            except NoAnswer as e:
                return self.send_json(408, {"error": str(e)})
            except RfidError as e:
                return self.send_json(422, {"error": str(e)})
            finally:
                lock.release()
            self.send_json(200, result)

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            if url.path == "/":
                query = urllib.parse.parse_qs(url.query).get("lang", [None])[0]
                cookies = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
                cookie = cookies["lang"].value if "lang" in cookies else None
                lang = pick_language(query, cookie, self.headers.get("Accept-Language"))
                extra = [("Set-Cookie", "lang=%s; Path=/; Max-Age=31536000; SameSite=Lax" % lang)] if query == lang else []
                return self.send(200, render_page(lang), "text/html; charset=utf-8", extra)
            if url.path == "/api/info":
                return self.with_reader(reader_info)
            self.send_json(404, {"error": "not found"})

        def do_POST(self):
            path = urllib.parse.urlsplit(self.path).path
            if path not in ("/api/read", "/api/write"):
                return self.send_json(404, {"error": "not found"})
            if self.headers.get("Content-Type", "").split(";")[0].strip() != "application/json":
                return self.send_json(415, {"error": "send JSON"})
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = json.loads(self.rfile.read(min(length, 65536)) or b"{}")
                if not isinstance(body, dict):
                    raise ValueError
                key = hex_key(body["key"]) if body.get("key") else None
                block = body.get("block")
                if block is not None and (not isinstance(block, int) or isinstance(block, bool) or block < 0):
                    raise ValueError
            except (ValueError, argparse.ArgumentTypeError):
                return self.send_json(400, {"error": "bad request: the key is 12 hex digits, the block a whole number"})
            if path == "/api/read":
                return self.with_reader(lambda r: read_chip(r, timeout, key, block, bool(body.get("dump"))))
            self.with_reader(lambda r: write_chip(r, body.get("kind"), body.get("value"), timeout, key, block))

        def log_message(self, fmt, *args):
            print("rfid: %s %s" % (self.address_string(), fmt % args), file=sys.stderr)

    server = http.server.ThreadingHTTPServer((host, port), Handler)
    server.daemon_threads = True
    return server


