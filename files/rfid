def pick_language(query_lang, cookie, accept):
    if query_lang in COPY:
        return query_lang
    if cookie in COPY:
        return cookie
    weighted = []
    for part in (accept or "").split(","):
        tag, _, params = part.strip().partition(";")
        q = 1.0
        if params.strip().startswith("q="):
            try:
                q = float(params.strip()[2:])
            except ValueError:
                q = 0
        weighted.append((q, tag.strip().lower().split("-")[0]))
    for q, tag in sorted(weighted, key=lambda w: -w[0]):
        if q > 0 and tag in COPY:
            return tag
    return "en"


